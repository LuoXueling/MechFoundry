# Regenerable intermediates for the BC-region figure (see build.sh bcregion).
# bc_bunny_geom.npz is a GPU/TripoSG cache: build.sh reuses it when present so
# the selector/render/compose steps can be iterated without re-decoding.
bc_bunny_geom.npz
bc_panel_*.png
bc_*.stl
bc_*.vtk

# Regenerable intermediates for the diffused-Nitsche figure (build.sh nitsche).
# dn_field.vtk is ~136 MB; everything here is rebuilt by dn_prep.py.
dn_panel_*.png
dn_*.stl
dn_*.vtk
_dn_sheet.png
_z_*.png
_v_*.png

# Regenerable intermediates for the void-nucleation figure (build.sh voidnuc).
# vn_prep.py re-runs the optimiser from scratch, so nothing here is a cache.
vn_panel_*.png
vn_*.vtk
vn_*.stl
_vn_sheet.png
_vn_run/

# Regenerable intermediates for the BC-restoration figures (build.sh bczip,
# bczipx).  The *_stats.txt files are NOT here: the compose steps read them,
# and they are the record of what the run actually did.
bz_p*.vtk
bz_patch_all.vtk
bz_capture.npz
bz_panel_*.png
_bz_sheet.png
bzx_*.vtk
bzx_panel_*.png

# Regenerable intermediates for the hidden-phi loop figure (build.sh hiddenphi).
# hp_prep.py re-runs the optimiser from scratch, so nothing here is a cache;
# hp_stats.txt is NOT here — the compose step reads it and it is the record of
# what the run actually did.
hp_panel_*.png
hp_*.vtk
hp_*.stl
hp_bc_masks.npz

# Regenerable intermediates for the twisting-box convergence figure
# (build.sh nitscheconv).  nc_ref_*.npz is a CACHE: the body-fitted reference
# solve is ~10 min, so the sweep reuses it; delete it to force a fresh one.
# nc_data.txt / nc_stats.txt are NOT here — the compose step reads them and
# they are the record of what the sweep measured.
nc_panel_*.png
nc_*.vtk
nc_ref_*.npz
# The 64^3 reference is kept: src/warp_wrapper/tests/test_nitsche_single_precision.py
# measures its accuracy against it, so the suite cannot pass without it on a fresh clone.
!nitscheconv/nc_ref_64.npz
nc_prep.log

# Regenerable intermediates for the whole-pipeline overview (build.sh overview).
# ov_t_*.png are panels pulled straight out of the OTHER figures' PDFs, and the
# two ov_input_* glyphs are re-rendered from bunny.stl, so none of it is a
# source.  ov_stats.txt / ov_bench_log.txt / ov_thumbs.json are NOT here: the
# first two are the measurement the figure's timings are quoted from, and the
# third records which panel of which figure each thumbnail came from.
ov_t_*.png
ov_sheet_*.png
ov_input_image.png
ov_input_mesh.png
ov_bench_run/

# Regenerable intermediates for the PartField bunny figures (build.sh pfbunny).
# pf_cache/ is a CACHE: the 290 MB feature array PartField infers, keyed by a
# manifest over the surface hash + checkpoint, so a rerun of the segment step
# reuses it instead of re-running the network.  pf_stats.txt is NOT here — the
# captions' counts are read from it and it is the record of what the run did.
pf_panel_*.png
pf_surface.stl
pf_surface.vtk
pf_topology.npz
pf_segments.npz
pf_segments.json
pf_segment.log
pf_cache/

# pf_palette.txt is regenerated by pf_prep.py and read by the CVD gate.
pf_palette.txt

# Regenerable intermediates for the agentic-results figure (build.sh agenticresults).
# _work/ holds the per-run prep records, panels and sheets; build.sh deletes it unless
# AR_KEEP_WORK=1.  ar_stats.json is NOT here: arfig copies it out of _work as the record
# of what the figure shows.
agentic_results/_work/
# _cwork/: the same for the model-comparison pages (build.sh agenticcompare, ARC_KEEP_WORK=1);
# _logs/: ar_categories.py's per-figure build logs.
agentic_results/_cwork/
agentic_results/_logs/

# Regenerable intermediates for the showcase (variation) figure (build.sh showcase).
# _work/ holds the per-item prep records and renders; build.sh deletes it unless
# SC_KEEP_WORK=1.  sc_stats.json is NOT here: the build copies it out of _work as the
# record of which runs, labels and numbers the figure shows.
showcase/_work/

# shape_opt_merged row c (build.sh shapeoptmerged): the clean-up BC surfaces the prep
# writes for render_som_cleanup.py.  panel_som_cu_*.png and som_cleanup.json are NOT
# here: they are the row's cache and record.
shapeopt/_cleanup/

# shape_opt_merged b's openness meshes (build.sh shapeoptmerged, ../_shared/void_open.py):
# regenerable in seconds from the committed so_evo_*_{shell,ghost}.stl; the rendered
# panel_so_m_evo_*.png are the committed cache.
shapeopt/so_evo_*_open.vtk

# challenge_overview: ch_prep.py rebuilds ch_geom.npz (CPU, seconds) on every build
ch_geom.npz

# The demo video (build.sh demovideo).  _work/ (and any _work_* copy) holds the prep surfaces, the pvbatch
# passes and the composed frames; demo_video.{mp4,png} at this root ARE tracked.
demo_video/_work*/
